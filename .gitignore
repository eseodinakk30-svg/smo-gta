# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated
/[Aa]ssets/[Ss]treamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/AddressableAssetsData/link.xml*
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Rider / VS / VSCode
.idea/
.vs/
.vscode/
.gradle/

# OS
.DS_Store
Thumbs.db

# Local compile-check sandbox
/.compilecheck/

# Compile-check build output
tools/compilecheck/bin/
tools/compilecheck/obj/

# ...but the compile-check project itself must be tracked: the "*.csproj" rule
# above is meant for the C# projects Unity regenerates, not for this one.
!tools/compilecheck/CompileCheck.csproj
